{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "cd *", "effect": "deny" },
    { "action": "shell", "resource": "pushd *", "effect": "deny" },
    { "action": "shell", "resource": "popd *", "effect": "deny" },
    { "action": "shell", "resource": "*..*", "effect": "ask" }
  ]
}
